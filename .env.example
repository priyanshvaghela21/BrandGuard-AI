# ==============================================================================
# BrandGuard AI — Unified Environment Configuration Template
# Copy this file to `.env` or `backend/.env` before starting the application.
# ==============================================================================

# --- Server & Environment ---
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# --- Database Configuration ---
# Production: PostgreSQL connection string
# Local development: If PostgreSQL is not running, BrandGuard automatically falls back to SQLite (backend/brandguard.db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brandguard_db

# --- AI Dual-Engine Keys ---
# Google Gemini API Key for LLM-powered contextual claims research & smart rewrites
GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional: Inkloom AI integration key for asset generation
INKLOOM_API_KEY=your_inkloom_api_key_here

# --- Authentication & Cryptographic Security ---
# Secret key used for signing JWT access tokens (HMAC-SHA256)
JWT_SECRET_KEY=brandguard-autonomous-governance-secret-key-2026-codex48
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS Allowed Origins ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://brandguard-zeta.vercel.app

# --- Frontend Vite Environment (Optional) ---
VITE_API_BASE_URL=http://127.0.0.1:8000
