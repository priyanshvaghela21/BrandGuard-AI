# BrandGuard Backend Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brandguard_db

# Google Gemini API Key for Dual-Engine Brand Compliance AI
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication Secret
JWT_SECRET_KEY=brandguard-autonomous-governance-secret-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
